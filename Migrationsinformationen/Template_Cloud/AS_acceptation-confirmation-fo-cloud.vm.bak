<?xml version="1.0" encoding="ISO-8859-1"?>
##____________________________________________________________________
##
## Auftragsbestätigung-V2.4-CLOUD: AS_acceptation-confirmation-fo-cloud.vm
##
## -------------------------------------------------------------------
##
## Stand: 01.02.2022 / Gr / V1.0
##        Anpassung an neues Corporate Design
##
##        20.05.2022 / Gr / V2.0
##        TIC 305: "i.A. gez." entfällt ersatzlos
##
## -------------------------------------------------------------------
##
## Stand: 19.04.23 / Gr  / V2.1
##         TIC-352   Fusszeile ohne Vorstände
##
## -------------------------------------------------------------------
##
## Stand: 27.07.23 / Gr  / V2.2
##         TIC-371: In Auftragsbestätigungen an Klienten soll
##                  nur die Mail des Regionalleiters genannt werden,
##                  keine Telefonnummer.
##
## -------------------------------------------------------------------
##
## Stand: 12.12.23 / Gr  / V2.3
##
## 1.   TIC-396: Der Sicherheitsupdate verursachte Probleme
##       bei Auftrags- und Rechnungsdokumenten
##
