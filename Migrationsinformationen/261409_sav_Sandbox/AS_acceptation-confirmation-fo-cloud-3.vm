## =====================================================================
## Sonderzeichen-Makro direkt im Template
## =====================================================================
#macro(decodeSonderzeichen $issue $customfield)
#set($wert = $issue.getCustomFieldValue($customfield))
#if($wert)
  #set($wert = $wert.toString())
  ## Kleinbuchstaben
  #set($wert = $wert.replace("ä", "ä"))
  #set($wert = $wert.replace("ö", "ö"))
  #set($wert = $wert.replace("ü", "ü"))
  #set($wert = $wert.replace("ß", "ß"))
  ## Großbuchstaben
  #set($wert = $wert.replace("Ä", "Ä"))
  #set($wert = $wert.replace("Ö", "Ö"))
  #set($wert = $wert.replace("Ü", "Ü"))
  #set($wert = $wert.replace("ẞ", "ẞ"))
  $wert
#end
#end
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format">
##____________________________________________________________________
##
## Empfangsbestätigung_V3.0 (CLOUD-VERSION): initial-confirmation-fo.vm
##
## Migriert von DC nach Cloud: 2025-08-13
## Cloud-ready V3.0: 2026-08-14 / Gr
##
## ÄNDERUNGEN gegenüber V2.0:
## - $customFieldManager.getCustomFieldObject("customfield_XXXXX")
##   ersetzt durch direkten String "customfield_XXXXX"
## - Select-Felder (customfield_10405/Land) mit Null-Check versehen
##
## BUGFIX V3.1: 2026-08-19
## - fo:table-body "Beratungsfall" in fo:table eingebettet (ValidationException)
##
## BUGFIX V3.2: 2026-08-23
## - Doppelt eingefügten Block "Regionalleitung" entfernt
## - Datum wird jetzt manuell als dd.MM.yyyy zusammengesetzt
## - E-Mail-Felder per replaceAll("<[^>]*>", "") bereinigt
## - region-body margin-top/margin-bottom erhöht
##
## BUGFIX V3.5: (diverse Layout-Fixes)
##
## BUGFIX V3.6: 2026-09-03
## - Fehlende schließende Klammern bei customfield_10464 (Wünsche) ergänzt
##   -> ParseErrorException an Zeile 468 behoben
##____________________________________________________________________
$include.parse($ctx, "AS_auftrag-common-elements-fo-cloud.vm")
#set($filename = "${issues.get(0).getCustomFieldValue('customfield_10200')}_Auftragsbestätigung.pdf")
## Debugging true/false – VOR PRODUKTIVEINSATZ auf false setzen!
#set($debug = false)

## BUGFIX V3.2: Datum fest als dd.MM.yyyy
#set($cDay = $currentDate.getDate())
#set($cMonth = $currentDate.getMonth())
#set($cMonth = $cMonth + 1)
#set($cYear = $currentDate.getYear())
#set($cYear = $cYear + 1900)
#set($cDayStr = "$cDay")
#if($cDay < 10)
    #set($cDayStr = "0$cDay")
#end
#set($cMonthStr = "$cMonth")
#if($cMonth < 10)
    #set($cMonthStr = "0$cMonth")
#end
#set($formattedDate = "${cDayStr}.${cMonthStr}.${cYear}")

<fo:layout-master-set>
    <fo:simple-page-master master-name="A4" margin-top="0.0cm" margin-bottom="0.0cm" margin-left="1.0cm" margin-right="1.0cm">
        <fo:region-body region-name="page-body" margin-top="0.5cm" margin-bottom="3.0cm" margin-left="1.5cm" margin-right="1.5cm"/>
        <fo:region-before region-name="page-header" extent="2.5cm" margin-left="1.5cm" margin-right="1.5cm"/>
        <fo:region-after region-name="page-footer" extent="2.5cm" margin-left="1.5cm" margin-right="1.5cm"/>
    </fo:simple-page-master>
</fo:layout-master-set>

<fo:page-sequence font-family="OpenSANS" font-size="8pt" master-reference="A4">

    <!-- Fußzeile -->
    <fo:static-content flow-name="page-footer" font-size="82%">
        <fo:block text-align="center"> Seite <fo:page-number/> </fo:block>
        <fo:block text-align="left">
            <fo:external-graphic content-width="190mm" src="url($xmlutils.escape($FZ_ImageUrl))" overflow="hidden"/>
        </fo:block>
    </fo:static-content>

    <!-- Seiteninhalt -->
    <fo:flow flow-name="page-body">

        #if($debug)
            <fo:block font-size="8pt" color="red">
                DEBUG – Verlinkte Issues:
            </fo:block>
            #foreach($type in $linkCollection.linkTypes)
                #foreach($i in $linkCollection.getInwardIssues($type.name))
                    <fo:block font-size="8pt">
                        Inward: $i.key | Projekt: $i.projectObject.name | Summary: $i.summary
                    </fo:block>
                #end
                #foreach($i in $linkCollection.getOutwardIssues($type.name))
                    <fo:block font-size="8pt">
                        Outward: $i.key | Projekt: $i.projectObject.name | Summary: $i.summary
                    </fo:block>
                #end
            #end
        #end

        <fo:block space-after="10mm"/>

        #if($project)

            <!-- ===== SEITE 1 ===== -->

            <!-- Kopfbereich mit Logo und Adresse -->
            <fo:block start-indent="0">
                <fo:table space-before="0cm" space-before.conditionality="retain">
                    <fo:table-column column-width="65%"/>
                    <fo:table-column column-width="35%"/>
                    <fo:table-body>

                        <!-- Logo -->
                        <fo:table-row>
                            <fo:table-cell number-columns-spanned="2">
                                <fo:block>
                                    <fo:external-graphic space-before="3mm"
                                        width="100%"
                                        content-width="scale-to-fit"
                                        scaling="uniform"
                                        src="url($xmlutils.escape($logoImageUrl_Banner))" overflow="hidden"/>
                                </fo:block>
                            </fo:table-cell>
                        </fo:table-row>

                        <!-- Adresse + Regionalleitung -->
                        <fo:table-row>
                            <fo:table-cell text-align="left" display-align="before">
                                <!-- BUGFIX V3.5: Abstand Logo -> Adresse direkt auf 1,5cm -->
                                <fo:block white-space-collapse="false" space-before="1.5cm"/>

                                <fo:block space-before="3mm" font-size="90%">AktivSenioren Bayern e.V. | Landshuter Allee 11 | 80637 München</fo:block>

                                <fo:block font-size="120%" space-before="3mm">
                                    #if($klient)
                                        <fo:block>$xmlutils.escape($!klient.getCustomFieldValue("customfield_10388"))</fo:block>
                                        <fo:block>$xmlutils.escape($!klient.getCustomFieldValue("customfield_10392")) $xmlutils.escape($!klient.getCustomFieldValue("customfield_10395"))</fo:block>
                                        <fo:block>$xmlutils.escape($!klient.getCustomFieldValue("customfield_10399"))</fo:block>
                                        <fo:block>$xmlutils.escape($!klient.getCustomFieldValue("customfield_10389")) $xmlutils.escape($!klient.getCustomFieldValue("customfield_10391"))</fo:block>
                                        <fo:block>
                                            #set($land = $klient.getCustomFieldValue("customfield_10405"))
                                            #if($land && $land.value != "Deutschland")
                                                $xmlutils.escape($!land.value)
                                            #end
                                        </fo:block>
                                    #else
                                        <!-- Fallback auf Auftrags-Daten oder Hinweisbox -->
                                        <fo:block>$xmlutils.escape($!issue.getCustomFieldValue("customfield_10388"))</fo:block>
                                        <fo:block color="red" font-weight="bold" space-before="2mm">
                                            Hinweis: Kein verknüpfter Klient gefunden!
                                        </fo:block>
                                    #end
                                </fo:block>
                            </fo:table-cell>
 
                            <!-- Regionalleitung & Datum -->
                            <fo:table-cell text-align="left">
                                <fo:block space-before="1.5cm"/>

                                <fo:block space-before="3mm" font-size="90%">
                                    Regionalleitung $!xmlutils.escape($region.getCustomFieldValue("customfield_10432"))
                                </fo:block>

                                <fo:block font-size="110%" space-before="2mm">
                                    <fo:block>
                                        $!xmlutils.escape($region.getCustomFieldValue("customfield_10306"))
                                    </fo:block>
                                </fo:block>

                                ## BUGFIX V3.2: Feldwert enthält rohes HTML - Tags entfernen
                                #set($rlEmailRaw = $region.getCustomFieldValue("customfield_10298"))
                                #set($rlEmail = "")
                                #if($rlEmailRaw)
                                    #set($rlEmail = $rlEmailRaw.toString().replaceAll("<[^>]*>", ""))
                                #end

                                <fo:block font-size="90%">
                                    M: $!xmlutils.escape($rlEmail)
                                </fo:block>

                                <fo:block font-size="90%" space-before="8mm">
                                    <fo:inline font-weight="bold">Datum: </fo:inline>$!formattedDate
                                </fo:block>
                            </fo:table-cell>

                        </fo:table-row>

                    </fo:table-body>
                </fo:table>
            </fo:block>

            <!-- Auftragsbestätigungstext -->
            <fo:block space-before="11mm"/>
            <fo:block font-size="100%" space-before="1cm" font-weight="bold">
                Auftragsbestätigung zu Auftrag Nr. $!xmlutils.escape($issues.get(0).getCustomFieldValue("customfield_10200"))
            </fo:block>

            <fo:block space-before="3mm">
                #set($renderedDescription = $pdfRenderer.asRendered($issues.get(0), "comment", $issues.get(0).getCustomFieldValue("customfield_10218")))
                <fo:block>$renderedDescription</fo:block>

                #set($renderedDescription = $pdfRenderer.asRendered($issues.get(0), "comment", $issues.get(0).getCustomFieldValue("customfield_10248")))
                <fo:block space-before="3mm">$renderedDescription</fo:block>

                #set($renderedDescription = $pdfRenderer.asRendered($issues.get(0), "comment", $issues.get(0).getCustomFieldValue("customfield_10238")))
                <fo:block space-before="6mm">$renderedDescription</fo:block>

                ## Allgemeines Number-Tool laden und an $numberTool binden
                #set($numberTool = $scripting.execute("AS_number-tool.groovy"))
                
                ## 1. Groovy-Skript ausführen (stellt $nettoFmt, $mwstSatzFmt, $mwstBetragFmt, $gesamtFmt bereit)
                $scripting.execute("AS_number-tool.groovy")
                
                ## 2. Preistabelle (nur wenn kein Rahmenauftrag)
                #set($issue = $issues.get(0))
                #set($auftragsartObj = $issue.getCustomFieldValue("customfield_10382"))
                #set($auftragsartVal = "")
                #if($auftragsartObj && $auftragsartObj.hasProperty("value"))
                    #set($auftragsartVal = $auftragsartObj.value)
                #elseif($auftragsartObj)
                    #set($auftragsartVal = $auftragsartObj.toString())
                #end
                
                #if($auftragsartVal != "Rahmenauftrag")
                    <fo:table space-before="4mm">
                        <fo:table-column column-width="110mm" />
                        <fo:table-column column-width="30mm"/>
                        <fo:table-body>
                            <fo:table-row font-weight="bold">
                                <fo:table-cell padding="2pt">
                                    <fo:block>Position</fo:block>
                                </fo:table-cell>
                                <fo:table-cell text-align="right" padding="2pt">
                                    <fo:block>Betrag</fo:block>
                                </fo:table-cell>
                            </fo:table-row>
                            <fo:table-row>
                                <fo:table-cell padding="2pt">
                                    <fo:block>$!xmlutils.escape($issue.getCustomFieldValue("customfield_10453"))</fo:block>
                                </fo:table-cell>
                                <fo:table-cell text-align="right" padding="2pt">
                                    <fo:block>$!nettoFmt</fo:block>
                                </fo:table-cell>
                            </fo:table-row>
                            <fo:table-row>
                                <fo:table-cell padding="2pt">
                                    <fo:block>zuzüglich $!mwstSatzFmt MwSt.</fo:block>
                                </fo:table-cell>
                                <fo:table-cell text-align="right" padding="2pt">
                                    <fo:block>$!mwstBetragFmt</fo:block>
                                </fo:table-cell>
                            </fo:table-row>
                            <fo:table-row font-weight="bold">
                                <fo:table-cell padding="2pt">
                                    <fo:block>Gesamt</fo:block>
                                </fo:table-cell>
                                <fo:table-cell text-align="right" padding="2pt">
                                    <fo:block>$!gesamtFmt</fo:block>
                                </fo:table-cell>
                            </fo:table-row>
                        </fo:table-body>
                    </fo:table>
                #else
                    <fo:block space-before="3mm" text-align="justify"/>
                #end
                ## Optionaler Zusatztext (customfield_10462)
                #if($issue.getCustomFieldValue("customfield_10462"))
                    #set($renderedDescription = $pdfRenderer.asRendered($issue, "comment", $issue.getCustomFieldValue("customfield_10462")))
                    <fo:block space-before="6mm">$renderedDescription</fo:block>
                #end

                <fo:block space-before="6mm">Mit freundlichen Grüßen</fo:block>
                <fo:block space-before="3mm">AktivSenioren Bayern e.V.</fo:block>
                <fo:block space-before="6mm">$!xmlutils.escape($region.getCustomFieldValue("customfield_10306"))</fo:block>

                ## Debug-Block (nur in TEST-Umgebung)
                #if($debug && $env == "TEST")
                    <fo:block space-before="6mm" color="red" font-size="8pt">
                        DEBUG – Umgebung: $env
                    </fo:block>
                #end

            </fo:block>
        #end
    </fo:flow>
</fo:page-sequence>
</fo:root>